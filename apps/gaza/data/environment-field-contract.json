{
  "schemaVersion": 1,
  "updatedAt": "2026-10-06",
  "purpose": "Operational environmental field for the GAZA digital twin. Public weather data can drive the visual field; proposed on-site sensors remain design placeholders until installed and commissioned.",
  "plantAnchor": {
    "lat": 41.52355,
    "lon": -5.59993,
    "authority": "data/site-reference.json"
  },
  "publicWeatherSource": {
    "provider": "Open-Meteo",
    "classification": "PUBLIC_REFERENCE_LIVE",
    "variables": [
      "temperature_2m",
      "apparent_temperature",
      "relative_humidity_2m",
      "surface_pressure",
      "weather_code",
      "precipitation",
      "wind_speed_10m",
      "wind_direction_10m",
      "wind_gusts_10m",
      "cloud_cover",
      "visibility"
    ],
    "policy": "Grid weather is not a substitute for calibrated on-site instrumentation or CFD."
  },
  "spatialField": {
    "classification": "DERIVED_VISUAL_FIELD_NOT_CFD",
    "model": "uniform base vector across campus with explicit non-CFD label",
    "axes": "X_EAST_Z_NORTH",
    "windConvention": "meteorological FROM degrees clockwise from north; renderer converts to flow-to vector",
    "limitations": [
      "No building-wake physics",
      "No terrain CFD",
      "No stack/plume dispersion",
      "No sensor calibration",
      "No safety-critical control"
    ],
    "visualEncoding": "concentric compass rings + animated streamlines around campus",
    "motion": "ANIMATED_STREAMLINES",
    "riskInputs": [
      "weather_code",
      "precipitation",
      "wind_speed_10m",
      "wind_gusts_10m",
      "visibility"
    ],
    "riskPolicy": "Operational context only; gust and low-visibility thresholds affect advisory risk, never safety interlocks."
  },

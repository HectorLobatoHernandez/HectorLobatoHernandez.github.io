{
  "schemaVersion": 2,
  "mode": "READ_ONLY_DISCOVERY",
  "updatedAt": "2026-10-06",
  "rules": [
    "No browser-to-PLC/ASRS/MES writes.",
    "No credential storage in browser or repository.",
    "Every adapter must identify source system, timestamp, quality and provenance.",
    "Synthetic/demo events must never be merged into REAL telemetry without explicit source tagging."
  ],
  "canonicalEvent": {
    "required": [
      "event_id",
      "source",
      "source_class",
      "observed_at",
      "entity_type",
      "entity_id",
      "event_type",
      "quality",
      "payload"
    ],
    "source_class": [
      "REAL_AUTHORIZED",
      "PUBLIC_REFERENCE",
      "SIMULATED"
    ],
    "quality": [
      "GOOD",
      "STALE",
      "UNCERTAIN",
      "BAD"
    ]
  },

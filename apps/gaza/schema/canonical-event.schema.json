{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hectorlobatohernandez.github.io/apps/gaza/schema/canonical-event.schema.json",
  "title": "GAZA Canonical Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id","source","source_class","observed_at","entity_type","entity_id","event_type","quality","payload"],
  "properties": {
    "event_id": {"type":"string","minLength":1},
    "source": {"type":"string","minLength":1},
    "source_class": {"enum":["REAL_AUTHORIZED","PUBLIC_REFERENCE","SIMULATED"]},
    "observed_at": {"type":"string","format":"date-time"},
    "entity_type": {"type":"string","minLength":1},
    "entity_id": {"type":"string","minLength":1},
    "event_type": {"type":"string","minLength":1},
    "quality": {"enum":["GOOD","STALE","UNCERTAIN","BAD"]},
    "payload": {"type":"object"},
    "provenance": {"type":"object"},
    "correlation": {"type":"object"}
  }
}
